", "Type": "Recipient", "Field": "error_6", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false}]}, {"Type": "Standard", "ID": "BL_evenHanded0002", "FlowID": "FL_5", "Autofill": []}, {"Type": "BlockRandomizer", "FlowID": "FL_6", "SubSet": 1, "EvenPresentation": true, "Flow": [{"Type": "Group", "FlowID": "FL_7", "Description": "High-value belief", "Flow": [{"Type": "EmbeddedData", "FlowID": "FL_8", "EmbeddedData": [{"Description": "value_cond", "Type": "Custom", "Field": "value_cond", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "high"}, {"Description": "belief_prompt", "Type": "Custom", "Field": "belief_prompt", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "For the first task, we would like for you to think of an important belief or attitude you have that is connected to your morals and that you feel strongly committed to. This belief is different for different people but could include things, such as views on abortion, gun control, capital punishment, religion, medical decision, same-sex marriage, etc. What attitude or belief do you care deeply about and feel strongly committed to? Briefly state it below (e.g., \"I think we need stronger gun control.\")"}]}]}, {"Type": "Group", "FlowID": "FL_9", "Description": "Low-value belief", "Flow": [{"Type": "EmbeddedData", "FlowID": "FL_10", "EmbeddedData": [{"Description": "value_cond", "Type": "Custom", "Field": "value_cond", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "low"}, {"Description": "belief_prompt", "Type": "Custom", "Field": "belief_prompt", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "For the first task, we would like for you to think of an unimportant belief or attitude you have that is not something connected to your morals or something that you feel strongly committed to. These could be simple preferences or tastes that you hold for fun; this belief is different for different people but they could include things like the best song ever made, the best movie ever made, the best athlete to ever live, the ideal vacation destination, the best food ingredients, the best novel ever written, etc. What attitude or belief do you hold that you do not care deeply about or feel highly committed to? Briefly state it below (e.g., \"Michael Jordan is the best basketball player of all time.\")"}]}]}]}, {"Type": "Standard", "ID": "BL_evenHanded0003", "FlowID": "FL_11", "Autofill": []}, {"Type": "EmbeddedData", "FlowID": "FL_12", "EmbeddedData": [{"Description": "topic", "Type": "Custom", "Field": "topic", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "${q://QID3/ChoiceTextEntryValue}"}, {"Description": "p_response", "Type": "Custom", "Field": "p_response", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "${q://QID4/ChoiceTextEntryValue}"}]}, {"Type": "Standard", "ID": "BL_evenHanded0004", "FlowID": "FL_13", "Autofill": []}, {"Type": "BlockRandomizer", "FlowID": "FL_14", "SubSet": 1, "EvenPresentation": true, "Flow": [{"Type": "Group", "FlowID": "FL_15", "Description": "Balanced", "Flow": [{"Type": "EmbeddedData", "FlowID": "FL_16", "EmbeddedData": [{"Description": "cond", "Type": "Custom", "Field": "cond", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "balanced"}]}]}, {"Type": "Group", "FlowID": "FL_17", "Description": "Congenial", "Flow": [{"Type": "EmbeddedData", "FlowID": "FL_18", "EmbeddedData": [{"Description": "cond", "Type": "Custom", "Field": "cond", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "congenial"}]}]}, {"Type": "Group", "FlowID": "FL_19", "Description": "Uncongenial", "Flow": [{"Type": "EmbeddedData", "FlowID": "FL_20", "EmbeddedData": [{"Description": "cond", "Type": "Custom", "Field": "cond", "VariableType": "String", "DataVisibility": [], "AnalyzeText": false, "Value": "uncongenial"}]}]}]}, {"Type": "Standard", "ID": "BL_evenHanded0005", "FlowID": "FL_21", "Autofill": []}, {"Type": "Standard", "ID": "BL_evenHanded0006", "FlowID": "FL_22", "Autofill": []}, {"Type": "Standard", "ID": "BL_evenHanded0007", "FlowID": "FL_23", "Autofill": []}, {"Type": "Standard", "ID": "BL_evenHanded0008", "FlowID": "FL_24", "Autofill": []}, {"Type": "Standard", "ID": "BL_evenHanded0009", "FlowID": "FL_25", "Autofill": []}, {"Type": "Standard", "ID": "BL_evenHanded0010", "FlowID": "FL_26", "Autofill": []}, {"Type": "Standard", "ID": "BL_evenHanded0011", "FlowID": "FL_27", "Autofill": []}], "Properties": {"Count": 27}}}, {"SurveyID": "SV_evenHandedChat01", "Element": "PROJ", "PrimaryAttribute": "CORE", "SecondaryAttribute": null, "TertiaryAttribute": "1.1.0", "Payload": {"ProjectCategory": "CORE", "SchemaVersion": "1.1.0"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "QC", "PrimaryAttribute": "Survey Question Count", "SecondaryAttribute": "30", "TertiaryAttribute": null, "Payload": null}, {"SurveyID": "SV_evenHandedChat01", "Element": "RS", "PrimaryAttribute": "RS_evenHanded01", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": null}, {"SurveyID": "SV_evenHandedChat01", "Element": "SCO", "PrimaryAttribute": "Scoring", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"ScoringCategories": [], "ScoringCategoryGroups": [], "ScoringSummaryCategory": null, "ScoringSummaryAfterQuestions": 0, "ScoringSummaryAfterSurvey": 0, "DefaultScoringCategory": null, "AutoScoringCategory": null}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SO", "PrimaryAttribute": "Survey Options", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"BackButton": "false", "SaveAndContinue": "true", "SurveyProtection": "PublicSurvey", "BallotBoxStuffingPrevention": "true", "NoIndex": "Yes", "SecureResponseFiles": "true", "SurveyExpiration": "None", "SurveyTermination": "DefaultMessage", "Header": "", "Footer": "", "ProgressBarDisplay": "None", "PartialData": "+1 week", "ValidationMessage": null, "PreviousButton": "", "NextButton": "", "SurveyTitle": "Qualtrics Survey | Qualtrics Experience Management", "NewScoring": 1, "EOSMessage": null, "ShowExportTags": "false", "CollectGeoLocation": "false", "PasswordProtection": "No", "AnonymizeResponse": "No", "RefererCheck": "No", "RecaptchaV3": "false", "ConfirmStart": false, "AutoConfirmStart": false, "RelevantID": "false", "ResponseSummary": "No", "EOSRedirectURL": null, "EmailThankYou": "false", "AvailableLanguages": {"EN": []}, "ProtectSelectionIds": true, "CustomStyles": {"customCSS": "body { margin: 0; padding: 0; }\n#chat-container { width: 100%; height: 100vh; max-height: 600px; border: 1px solid #ddd; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; margin: 0 auto; font-size: 16px; }\n#chat-history-1 { height: calc(100% - 56px); overflow-y: auto; padding: 10px; }\n.message { display: flex; flex-direction: column; margin: 10px 0; white-space: pre-wrap; }\n.user-message { margin-left: auto; max-width: 70%; padding: 0.5rem .875rem; border-radius: 12px 12px 0 12px; line-height: 1.5; word-wrap: break-word; position: relative; width: fit-content; font-family: helvetica; background-color: #007AFF; color: white; }\n.bot-message { max-width: 70%; padding: 0.5rem .875rem; border-radius: 12px 12px 12px 0; line-height: 1.5; word-wrap: break-word; position: relative; width: fit-content; font-family: helvetica; background-color: #F2F2F2; color: #333; }\n.bot-message.typing { font-style: italic; color: #888; }\n.bot-message.error { background: #fdecea; }\n.user-message.failed { opacity: .55; }\n#chat-input { display: flex; align-items: flex-end; padding: 10px; background-color: #F9F9F9; width: 100%; box-sizing: border-box; }\n#message-input-1 { flex: 1; margin-right: 10px; padding: 10px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box; font-size: 16px; font-family: inherit; resize: none; overflow-y: auto; line-height: 1.4; max-height: calc(6 * 1.4em + 16px); }\n#send-button-1 { background-color: #007AFF; border: none; color: white; padding: 10px; border-radius: 5px; cursor: pointer; transition: background-color 0.3s ease; }\n#send-button-1:hover { background-color: #0066CC; }"}}}, {"SurveyID": "SV_evenHandedChat01", "Element": "STAT", "PrimaryAttribute": "Survey Statistics", "SecondaryAttribute": null, "TertiaryAttribute": null, "Payload": {"MobileCompatible": true, "ID": "Survey Statistics"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID1", "SecondaryAttribute": "[CONSENT: paste your IRB-approved consent form here before launch.]", "TertiaryAttribute": null, "Payload": {"QuestionText": "<strong>[CONSENT: paste your IRB-approved consent form here before launch.]</strong>", "DataExportTag": "consent", "QuestionType": "DB", "Selector": "TB", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "NextChoiceId": 1, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "Language": [], "GradingData": [], "QuestionID": "QID1", "QuestionDescription": "[CONSENT: paste your IRB-approved consent form here before launch.]"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID2", "SecondaryAttribute": "Today, you will be chatting with an AI chatbot designed specifically for this study. We are interest", "TertiaryAttribute": null, "Payload": {"QuestionText": "Today, you will be chatting with an AI chatbot designed specifically for this study. We are interested in understanding how humans and AI models can interact and engage in discussions around various topics.", "DataExportTag": "intro", "QuestionType": "DB", "Selector": "TB", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "NextChoiceId": 1, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "Language": [], "GradingData": [], "QuestionID": "QID2", "QuestionDescription": "Today, you will be chatting with an AI chatbot designed specifically for this study. We are interest"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID3", "SecondaryAttribute": "${e://Field/belief_prompt}", "TertiaryAttribute": null, "Payload": {"QuestionText": "${e://Field/belief_prompt}", "DataExportTag": "belief", "QuestionType": "TE", "Selector": "SL", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "TotalChar", "MinChars": "1", "TotalChars": "200"}}, "NextChoiceId": 1, "NextAnswerId": 1, "SearchSource": {"AllowFreeResponse": "false"}, "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "Language": [], "GradingData": [], "QuestionID": "QID3", "QuestionDescription": "${e://Field/belief_prompt}"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID4", "SecondaryAttribute": "Now, please briefly explain why you hold that belief. ${q://QID3/ChoiceTextEntryValue}", "TertiaryAttribute": null, "Payload": {"QuestionText": "Now, please briefly explain why you hold that belief.<span id=\"belief-src\" style=\"display:none\">${q://QID3/ChoiceTextEntryValue}</span>", "DataExportTag": "belief_why", "QuestionType": "TE", "Selector": "ML", "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "TotalChar", "MinChars": "1", "TotalChars": "500"}}, "NextChoiceId": 1, "NextAnswerId": 1, "SearchSource": {"AllowFreeResponse": "false"}, "QuestionJS": "/*\n * Balanced (\"even-handed\") chatbot engine.\n *\n * The bot is a conversation partner first: the model writes each reply as a\n * natural message, and weaves into it ONE point that supports the participant's\n * current leaning and ONE that challenges it. The model also reports those two\n * points separately (JSON), so every turn's balance can be checked and logged.\n *\n * No imports and no build step: this file can be pasted verbatim at the top of a\n * Qualtrics question's JavaScript (see qualtrics/README.md). It is also loaded by\n * the standalone test page (index.html) and by the Node tests.\n */\nvar BalancedChat = (function () {\n  \"use strict\";\n\n  // One shared prompt for all bots (the researcher's wording, no examples). Only\n  // {condition_rules} differs between the balanced, congenial and uncongenial\n  // conditions. Question endings, the side reminder and the \"idk\" stance rule\n  // are handled in code (withHint, recordTurn).\n  var DEFAULT_PROMPT = [\n    'You\\'re chatting with someone who believes \"{topic}\". Why, in their words: \"{p_response}\".',\n    \"Talk like a friendly person texting: casual, 2-3 short sentences (25-40 words, never over {word_limit}). Reply directly to what they just said and keep it about the topic.\",\n    \"Don't open by agreeing with or praising them (\\\"exactly\\\", \\\"totally\\\", \\\"great point\\\").\",\n    \"Don't repeat a point or a question you've already used.\",\n    \"If they're brief or uninterested, keep it short and casual; never treat the chat like an assignment.\",\n    \"{condition_rules}\"\n  ].join(\"\\n\");\n\n  // Always appended after the prompt: the code needs this reply format to show the\n  // message and log stance/support/dissent. Not part of the editable prompt.\n  var FORMAT_INSTRUCTIONS = [\n    'Reply ONLY with JSON: {\"stance\":\"\",\"message\":\"\",\"support\":\"\",\"dissent\":\"\"}',\n    'stance: \"original\", \"shifted\" (now leaning the other way) or \"mixed\". message: what they\\'ll read. support / dissent: a few words naming the point you made for / against their view (leave one empty if there\\'s none).'\n  ].join(\"\\n\");\n\n  // The only part of the prompt that differs between conditions.\n  var CONDITIONS = {\n    balanced: {\n      rules: [\n        \"Be even-handed in the way you discuss the topic. In every message, naturally work in one point for the view they lean toward now and one point against it.\",\n        \"If they move toward the other side, continue to be even-handed: back their new view and also suggest backing for the alternative side.\"\n      ].join(\"\\n\"),\n      examples: \"\",\n      rewrite: \"keeping one point for and one against\"\n    },\n    congenial: {\n      rules: \"In every message, naturally work in one point that supports their view. You can briefly acknowledge the other side, but every message should land in support of their view.\",\n      examples: \"\",\n      rewrite: \"keeping the point that supports their view\"\n    },\n    uncongenial: {\n      rules: \"In every message, naturally work in one point that challenges their view. You can briefly acknowledge what they said, but every message should land against their view.\",\n      examples: \"\",\n      rewrite: \"keeping the point that challenges their view\"\n    }\n  };\n\n  function conditionOf(cfg) {\n    return CONDITIONS[cfg && cfg.condition] ? cfg.condition : \"balanced\";\n  }\n\n  var DEFAULT_OPENING_PROMPT =\n    'Here is what the participant wrote about why they hold their view: \"{p_response}\". ' +\n    \"Start the conversation by reacting to it, in the JSON format.\";\n\n  var DEFAULTS = {\n    proxy_url: \"https://balanced-chat-proxy.bthall3.workers.dev/\",\n    model: \"gpt-5.6-luna\",\n    reasoning_effort: \"none\", // reasoning models: \"none\" keeps replies fast and allows temperature\n    temperature: 0.5,\n    max_tokens: 300,\n    word_limit: 60,\n    max_messages: 7,\n    // \"balanced\" (for + against their current leaning) | \"congenial\" (supports their\n    // original view) | \"uncongenial\" (challenges their original view)\n    condition: \"balanced\",\n    delay_ms_per_word: 200,\n    max_delay_ms: 8000,\n    request_timeout_ms: 20000,\n    prompt_template: DEFAULT_PROMPT,\n    opening_template: DEFAULT_OPENING_PROMPT,\n    // If a message is over word_limit, ask the model once for a shorter rewrite;\n    // if it is still too long it is shown anyway and flagged (over_limit).\n    enforce_word_limit: true,\n    // The code decides whether each reply ends with a question (the model, left to\n    // itself, either always or never asks one): the opening and even turns ask,\n    // odd turns end on a statement, and a low-effort participant message always\n    // gets an easy question. The hint goes to the model only, not into history.\n    alternate_questions: true,\n    question_hint: \"(For this reply: end with one short, easy question about the topic in general, not about their own life or routine, and different from any question you've asked so far.)\",\n    statement_hint: \"(For this reply: end on a statement, not a question.)\",\n    // Directional bots drift toward the middle late in a chat, so every request\n    // repeats which side to land on (sent with the request only, like the hints above).\n    side_hint_congenial: \"(Your point should land in support of their original view: \\\"{topic}\\\".)\",\n    side_hint_uncongenial: \"(Your point should land against their original view: \\\"{topic}\\\".)\",\n    // Directional bots only: a second, quick model call grades each message as\n    // FOR / AGAINST / NEITHER the original view while it is being shown. If it\n    // landed on the wrong side, the next request swaps the side reminder for this\n    // correction ({drift} says how the last message came across).\n    direction_check: true,\n    direction_fix_hint_congenial: \"(Your last message came across as {drift}. Make sure this one lands in support of their original view: \\\"{topic}\\\".)\",\n    direction_fix_hint_uncongenial: \"(Your last message came across as {drift}. Make sure this one lands against their original view: \\\"{topic}\\\".)\",\n    closing_message: \"Thank you for the conversation! We will now move on to the next part of the study.\",\n    error_message: \"Sorry, something went wrong. Please send your message again.\",\n    opening_fallback: \"Thanks for sharing your view. What would you like to discuss about this topic?\"\n  };\n\n  // Only known placeholders are filled, so JSON braces in the template are left alone.\n  // ack/reply/point/question_words are kept so older saved prompts still fill in.\n  function fillTemplate(template, vars) {\n    return String(template).replace(/\\{(topic|p_response|drift|word_limit|ack_words|reply_words|point_words|soft_words|question_words)\\}/g, function (m, key) {\n      var v = vars[key];\n      return v === undefined || v === null ? \"\" : String(v).replace(/[\\r\\n]+/g, \" \").trim();\n    });\n  }\n\n  // Legacy placeholders for older custom prompts (e.g. {soft_words}).\n  function wordBudgets(cfg) {\n    var limit = parseInt(cfg.word_limit, 10) || 50;\n    return {\n      word_limit: limit,\n      soft_words: Math.max(Math.floor(limit * 0.2), 5),\n      ack_words: 0,\n      reply_words: Math.floor(limit * 0.2),\n      point_words: Math.floor(limit * 0.3),\n      question_words: Math.floor(limit * 0.2)\n    };\n  }\n\n  function templateVars(cfg, vars) {\n    var b = wordBudgets(cfg);\n    b.topic = vars.topic;\n    b.p_response = vars.p_response;\n    return b;\n  }\n\n  // Drop the condition's rules and examples into the shared template, then fill\n  // the remaining placeholders (the rules themselves use {soft_words}).\n  function applyCondition(template, cfg) {\n    var c = CONDITIONS[conditionOf(cfg)];\n    return String(template)\n      .replace(\"{condition_rules}\", function () { return c.rules; })\n      .replace(\"{examples}\", function () { return c.examples; });\n  }\n\n  function buildSystemPrompt(cfg, vars) {\n    var prompt = fillTemplate(applyCondition(cfg.prompt_template, cfg), templateVars(cfg, vars)).trim();\n    return prompt + \"\\n\\n\" + FORMAT_INSTRUCTIONS;\n  }\n\n  function buildOpeningPrompt(cfg, vars) {\n    return fillTemplate(cfg.opening_template, templateVars(cfg, vars));\n  }\n\n  // Same body shape the launched Qualtrics arms send to the proxy, plus reasoning_effort.\n  function buildRequest(cfg, system, history, prompt) {\n    return {\n      prompt: prompt,\n      system: system,\n      history: history,\n      model: cfg.model,\n      temperature: Number(cfg.temperature),\n      max_tokens: parseInt(cfg.max_tokens, 10),\n      reasoning_effort: cfg.reasoning_effort\n    };\n  }\n\n  function asText(v) {\n    return typeof v === \"string\" ? v.trim() : \"\";\n  }\n\n  var STANCES = [\"original\", \"shifted\", \"mixed\"];\n\n  // Has the participant moved toward the other side? Then the bot follows them.\n  function hasShifted(parts) {\n    return !!parts && (parts.stance === \"shifted\" || parts.stance === \"mixed\");\n  }\n\n  // Accepts clean JSON, ```json fenced``` JSON, or JSON surrounded by prose.\n  // What a valid turn must contain depends on the condition: balanced needs both\n  // considerations; congenial needs one supporting, uncongenial one challenging\n  // the participant's original view.\n  function parseBalancedReply(text, condition) {\n    var raw = typeof text === \"string\" ? text : \"\";\n    var start = raw.indexOf(\"{\");\n    var end = raw.lastIndexOf(\"}\");\n    if (start === -1 || end <= start) return { ok: false, parts: null, raw: raw };\n    var obj;\n    var body = raw.slice(start, end + 1);\n    try {\n      obj = JSON.parse(body);\n    } catch (e) {\n      // The model sometimes closes with a stray comma or quote: ...\"dissent\":\"x\",\"}\n      try {\n        obj = JSON.parse(body.replace(/,\\s*\"?\\s*\\}$/, \"}\"));\n      } catch (e2) {\n        return { ok: false, parts: null, raw: raw };\n      }\n    }\n    var stance = asText(obj.stance).toLowerCase();\n    var parts = {\n      stance: STANCES.indexOf(stance) !== -1 ? stance : \"\",\n      message: asText(obj.message),\n      support: asText(obj.support),\n      dissent: asText(obj.dissent)\n    };\n    // A turn counts as balanced only if the model wrote a message and reports\n    // both a supporting and a challenging consideration woven into it.\n    var cond = CONDITIONS[condition] ? condition : \"balanced\";\n    // Directional bots may briefly acknowledge the other side (it can show up in\n    // the other field); what matters is that their own consideration is there.\n    var ok = !!parts.message && (\n      cond === \"congenial\" ? !!parts.support :\n      cond === \"uncongenial\" ? !!parts.dissent :\n      !!parts.support && !!parts.dissent\n    );\n    return { ok: ok, parts: parts, raw: raw };\n  }\n\n  function countWords(text) {\n    return String(text || \"\").split(/\\s+/).filter(Boolean).length;\n  }\n\n  // \"idk\", \"maybe\", \"ok cool\", \"probably emergencies mostly\": a disengaged reply.\n  var LOW_EFFORT = /^(idk|i\\s*d(on'?t|unno)\\s*know|dunno|maybe|i guess|guess so|ok(ay)?|k|sure|yeah?|yea|ya|yep|nah|no|whatever|fine|lol|cool|true|same)\\b/i;\n\n  function isLowEffort(message) {\n    var m = String(message || \"\").trim();\n    var n = countWords(m);\n    return n <= 5 || (n <= 10 && LOW_EFFORT.test(m));\n  }\n\n  // Pure filler (\"idk\", \"maybe\", \"yeah probably\", \"i guess\"): no position taken.\n  // Narrower than isLowEffort, so a short concession like \"ok you're right\" is\n  // still read as a possible shift.\n  var FILLER = (\"idk i dunno dont don't know maybe guess so not sure ok okay k whatever lol cool eh meh \" +\n    \"hmm probably possibly perhaps kinda sorta yeah ya yea yep im i'm tired\").split(\" \");\n\n  function isNoncommittal(message) {\n    var words = String(message || \"\").toLowerCase().replace(/[^a-z' ]+/g, \" \").split(/\\s+/).filter(Boolean);\n    return words.length > 0 && words.length <= 6 && words.every(function (w) { return FILLER.indexOf(w) !== -1; });\n  }\n\n  // Which ending this reply should have: the opening and even turns ask a\n  // question, odd turns end on a statement, and a low-effort reply always gets\n  // an easy question so the participant has something simple to answer.\n  function endingHint(cfg, turn, participantMessage) {\n    if (!cfg.alternate_questions) return \"\";\n    var ask = turn === 0 || turn % 2 === 0 || isLowEffort(participantMessage);\n    return ask ? cfg.question_hint : cfg.statement_hint;\n  }\n\n  /*\n   * opts:\n   *   cfg      - settings (missing keys fall back to DEFAULTS)\n   *   vars     - { topic, p_response }: the participant's belief and why they hold it\n   *   store    - { set(key, value) }  (Qualtrics: setEmbeddedData)\n   *   dom      - { history, input, button } elements\n   *   fetch    - optional fetch implementation (tests / mock mode)\n   *   onBotReply(record) - called after each bot turn is shown\n   *   onDone()           - called after the closing message\n   *   onRequestError(turn, message) - called when a request fails\n   *   setTimeout         - optional timer (tests)\n   */\n  function createChat(opts) {\n    var cfg = {};\n    var k;\n    for (k in DEFAULTS) cfg[k] = DEFAULTS[k];\n    for (k in opts.cfg || {}) if (opts.cfg[k] !== undefined && opts.cfg[k] !== \"\") cfg[k] = opts.cfg[k];\n\n    var vars = opts.vars || {};\n    var store = opts.store || { set: function () {} };\n    var dom = opts.dom;\n    var fetchFn = opts.fetch || function (url, init) { return fetch(url, init); };\n    var timer = opts.setTimeout || setTimeout;\n    var onBotReply = opts.onBotReply || function () {};\n    var onDone = opts.onDone || function () {};\n    var onRequestError = opts.onRequestError || function () {};\n    var maxMessages = parseInt(cfg.max_messages, 10);\n\n    var condition = conditionOf(cfg);\n    var system = buildSystemPrompt(cfg, vars);\n    var state = { history: [], turn: 0, busy: false, done: false, stopped: false, records: [], errors: {} };\n    var typingEl = null;\n\n    function addBubble(text, who, extraClass) {\n      var el = document.createElement(\"div\");\n      el.classList.add(\"message\", who === \"user\" ? \"user-message\" : \"bot-message\");\n      if (extraClass) el.classList.add(extraClass);\n      el.textContent = text;\n      dom.history.appendChild(el);\n      dom.history.scrollTop = dom.history.scrollHeight;\n      return el;\n    }\n\n    function setBusy(busy) {\n      state.busy = busy;\n      var locked = busy || state.done;\n      dom.input.disabled = locked;\n      dom.button.disabled = locked;\n      if (busy && !typingEl) {\n        typingEl = addBubble(\"typing…\", \"bot\", \"typing\");\n      } else if (!busy && typingEl) {\n        typingEl.parentNode.removeChild(typingEl);\n        typingEl = null;\n      }\n      if (!locked) dom.input.focus();\n    }\n\n    function logError(turn, message) {\n      state.errors[turn] = (state.errors[turn] ? state.errors[turn] + \" | \" : \"\") + message;\n      store.set(\"error_\" + turn, state.errors[turn]);\n    }\n\n    // One proxy call with a timeout. Resolves to the model's text.\n    // `over` replaces request fields (system, temperature, max_tokens), e.g. for the direction check.\n    function callProxy(history, prompt, over) {\n      var controller = typeof AbortController !== \"undefined\" ? new AbortController() : null;\n      var t = timer(function () { if (controller) controller.abort(); }, cfg.request_timeout_ms);\n      var body = buildRequest(cfg, system, history, prompt);\n      for (var key in over || {}) body[key] = over[key];\n      return fetchFn(cfg.proxy_url, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(body),\n        signal: controller ? controller.signal : undefined\n      })\n        .then(function (res) {\n          if (!res.ok) {\n            // Surface the proxy's { error } message, e.g. a bad model name or missing key.\n            return res.json().catch(function () { return {}; }).then(function (d) {\n              throw new Error(\"HTTP \" + res.status + (d && d.error ? \": \" + d.error : \"\"));\n            });\n          }\n          return res.json();\n        })\n        .then(function (data) {\n          clearTimeout(t);\n          if (!data || typeof data.text !== \"string\" || !data.text.trim()) {\n            throw new Error(\"Empty response\" + (data && data.error ? \": \" + JSON.stringify(data.error) : \"\"));\n          }\n          return data.text;\n        }, function (err) {\n          clearTimeout(t);\n          throw err;\n        });\n    }\n\n    function finalize(history, prompt, parsed, turn) {\n      return Promise.resolve(enforceLimit(history, prompt, parsed, turn));\n    }\n\n    var WANT = { congenial: \"FOR\", uncongenial: \"AGAINST\" };\n    var DRIFT = { FOR: \"supporting their original view\", AGAINST: \"against their original view\", NEITHER: \"neutral or in the middle\" };\n\n    // Second model call: does this message land FOR, AGAINST or NEITHER the\n    // participant's original view? Resolves to \"\" if the check itself fails.\n    function judgeDirection(message) {\n      var judgeSystem =\n        'You check one chatbot message from a conversation with someone who believes \"' + clean(vars.topic) + '\". ' +\n        \"Taken as a whole, does the message land FOR that belief, AGAINST it, or NEITHER (balanced, neutral or unclear)? \" +\n        \"Answer with one word: FOR, AGAINST or NEITHER.\";\n      return callProxy([], message, { system: judgeSystem, temperature: 0, max_tokens: 10 })\n        .then(function (text) {\n          var m = /\\b(FOR|AGAINST|NEITHER)\\b/i.exec(text);\n          return m ? m[1].toUpperCase() : \"\";\n        }, function () { return \"\"; });\n    }\n\n    function clean(v) {\n      return String(v == null ? \"\" : v).replace(/[\\r\\n]+/g, \" \").trim();\n    }\n\n    // Grades the message just shown; the verdict steers the next reply (see withHint).\n    // Nothing is rewritten, so the check adds no wait beyond the typing delay.\n    function checkDirection(record) {\n      if (!WANT[condition] || !cfg.direction_check || !record.parse_ok) return Promise.resolve();\n      return judgeDirection(record.shown).then(function (verdict) {\n        record.direction = verdict;\n        store.set(\"direction_\" + record.turn, verdict);\n        if (verdict && verdict !== WANT[condition]) logError(record.turn, \"direction check: \" + verdict + \", next reply steered back\");\n      });\n    }\n\n    // Calls the model. An unreadable reply is retried once as-is; a readable one\n    // that points the wrong way for the condition gets one targeted repair request.\n    function getBalancedReply(history, prompt, turn) {\n      return callProxy(history, prompt).then(function (text) {\n        var parsed = parseBalancedReply(text, condition);\n        if (parsed.ok) return finalize(history, prompt, parsed, turn);\n        var readable = parsed.parts && parsed.parts.message;\n        var retryHistory = readable\n          ? history.concat([{ role: \"user\", content: prompt }, { role: \"assistant\", content: parsed.raw }])\n          : history;\n        var retryPrompt = readable ? repairPrompt(parsed.parts) : prompt;\n        logError(turn, readable ? \"wrong direction for condition, asked for repair\" : \"unparseable reply, retried\");\n        return callProxy(retryHistory, retryPrompt).then(function (text2) {\n          var parsed2 = parseBalancedReply(text2, condition);\n          if (parsed2.ok) return finalize(history, prompt, parsed2, turn);\n          return parsed2.parts && parsed2.parts.message ? parsed2 : readable ? parsed : parsed2;\n        });\n      });\n    }\n\n    // Names what's missing from a readable reply so the rewrite can fix just that.\n    function repairPrompt(parts) {\n      var needed = condition === \"congenial\" ? \"a consideration that supports their original view\"\n        : condition === \"uncongenial\" ? \"a consideration that challenges their original view\"\n        : !parts.support ? \"a consideration that supports their current leaning\" : \"a consideration that challenges it\";\n      var fix = \"Your message was missing \" + needed + \". Rewrite it with that woven in.\";\n      return fix + \" Keep the same tone and length. Respond ONLY with the JSON.\";\n    }\n\n    // Over the limit: ask once for a shorter rewrite. Free prose can't be cut\n    // safely, so if it is still too long, the shorter version is shown and the\n    // turn is flagged.\n    function enforceLimit(history, prompt, parsed, turn) {\n      var limit = parseInt(cfg.word_limit, 10);\n      var words = countWords(parsed.parts.message);\n      if (!cfg.enforce_word_limit || !limit || words <= limit) return parsed;\n\n      var rewriteHistory = history.concat(\n        [{ role: \"user\", content: prompt }, { role: \"assistant\", content: parsed.raw }]\n      );\n      var rewritePrompt =\n        \"That message was \" + words + \" words; the limit is \" + limit + \". Rewrite it shorter, keeping it \" +\n        \"conversational and \" + CONDITIONS[condition].rewrite + \". \" +\n        \"Respond ONLY with the JSON.\";\n      logError(turn, \"over word limit (\" + words + \"), asked for rewrite\");\n\n      function keep(p) {\n        if (countWords(p.parts.message) > limit) logError(turn, \"still over word limit after rewrite\");\n        return p;\n      }\n\n      return callProxy(rewriteHistory, rewritePrompt).then(function (text) {\n        var again = parseBalancedReply(text, condition);\n        if (!again.ok) return keep(parsed);\n        return keep(countWords(again.parts.message) < words ? again : parsed);\n      }, function () {\n        return keep(parsed);\n      });\n    }\n\n    function recordTurn(turn, userMessage, parsed) {\n      // Invalid for the condition but readable: show the model's message (the turn\n      // is flagged parse_ok 0), never the raw JSON. Unreadable: show the raw text.\n      var readable = parsed.parts && parsed.parts.message;\n      var shown = parsed.ok ? parsed.parts.message : readable ? parsed.parts.message : parsed.raw.trim();\n      // \"idk\" / \"maybe\" is not a change of mind: keep the previous stance even if\n      // the model read it as one.\n      var prev = null;\n      for (var i = state.records.length - 1; i >= 0 && !prev; i--) {\n        if (state.records[i].stance) prev = state.records[i].stance;\n      }\n      var overridden = 0;\n      if (readable && turn > 0 && prev && isNoncommittal(userMessage) && parsed.parts.stance !== prev) {\n        parsed.parts.stance = prev;\n        overridden = 1;\n      }\n      var record = {\n        turn: turn,\n        user: userMessage,\n        shown: shown,\n        parts: parsed.parts,\n        raw: parsed.raw,\n        stance: readable ? parsed.parts.stance : \"\",\n        stance_overridden: overridden,\n        direction: \"\",\n        parse_ok: parsed.ok ? 1 : 0,\n        words: countWords(shown),\n        over_limit: countWords(shown) > parseInt(cfg.word_limit, 10) ? 1 : 0\n      };\n      if (turn > 0) store.set(\"msg_\" + turn, userMessage);\n      store.set(\"response_\" + turn, shown);\n      store.set(\"support_\" + turn, readable ? parsed.parts.support : \"\");\n      store.set(\"dissent_\" + turn, readable ? parsed.parts.dissent : \"\");\n      store.set(\"stance_\" + turn, record.stance);\n      if (WANT[condition]) store.set(\"direction_\" + turn, record.direction);\n      store.set(\"parse_ok_\" + turn, String(record.parse_ok));\n      store.set(\"words_\" + turn, String(record.words));\n      state.records.push(record);\n      // Keep the JSON in history so the model keeps answering in JSON.\n      if (turn > 0) state.history.push({ role: \"user\", content: userMessage });\n      state.history.push({\n        role: \"assistant\",\n        content: parsed.ok ? JSON.stringify(parsed.parts) : parsed.raw\n      });\n      return record;\n    }\n\n    // The direction check runs during the typing delay; the bubble waits for both.\n    function showAfterDelay(record) {\n      var delay = Math.min(countWords(record.shown) * Number(cfg.delay_ms_per_word || 0), cfg.max_delay_ms);\n      var checked = checkDirection(record);\n      return new Promise(function (resolve) {\n        timer(function () { checked.then(go, go); }, delay);\n        function go() {\n          if (state.stopped) return resolve(null);\n          setBusy(false);\n          addBubble(record.shown, \"bot\");\n          onBotReply(record);\n          resolve(record);\n        }\n      });\n    }\n\n    // The ending instruction rides along in the request only; history keeps the\n    // participant's actual words.\n    function withHint(prompt, turn, participantMessage) {\n      var last = state.records[state.records.length - 1];\n      var drifted = last && last.direction && WANT[condition] && last.direction !== WANT[condition];\n      var sideKey = (drifted ? \"direction_fix_hint_\" : \"side_hint_\") + condition;\n      var side = cfg[sideKey] ? fillTemplate(cfg[sideKey], { topic: vars.topic, drift: drifted ? DRIFT[last.direction] : \"\" }) : \"\";\n      var hints = [side, endingHint(cfg, turn, participantMessage)].filter(function (h) { return h; });\n      return hints.length ? prompt + \"\\n\\n\" + hints.join(\" \") : prompt;\n    }\n\n    function start() {\n      setBusy(true);\n      return getBalancedReply([], withHint(buildOpeningPrompt(cfg, vars), 0, \"\"), 0)\n        .then(function (parsed) {\n          return showAfterDelay(recordTurn(0, \"\", parsed));\n        })\n        .catch(function (err) {\n          if (state.stopped) return null;\n          logError(0, String(err && err.message ? err.message : err));\n          onRequestError(0, String(err && err.message ? err.message : err));\n          var record = recordTurn(0, \"\", { ok: false, parts: null, raw: cfg.opening_fallback });\n          setBusy(false);\n          addBubble(record.shown, \"bot\");\n          onBotReply(record);\n          return record;\n        });\n    }\n\n    function finish(message, turn) {\n      state.turn = turn;\n      store.set(\"msg_\" + turn, message);\n      state.done = true;\n      setBusy(false);\n      addBubble(cfg.closing_message, \"bot\", \"closing\");\n      onDone();\n    }\n\n    // Grow the message box with its content (CSS max-height caps it; then it scrolls).\n    function autoGrow() {\n      var el = dom.input;\n      if (!el.style || el.tagName !== \"TEXTAREA\") return;\n      el.style.height = \"auto\";\n      el.style.height = el.scrollHeight + (el.offsetHeight - el.clientHeight) + \"px\";\n    }\n\n    function send() {\n      if (state.busy || state.done) return Promise.resolve(null);\n      var message = (dom.input.value || \"\").trim();\n      if (!message) return Promise.resolve(null);\n      var turn = state.turn + 1;\n      dom.input.value = \"\";\n      autoGrow();\n      var userEl = addBubble(message, \"user\");\n\n      // Last participant message: no API call, so a failed request can't strand anyone.\n      if (turn >= maxMessages) {\n        finish(message, turn);\n        return Promise.resolve(null);\n      }\n\n      setBusy(true);\n      return getBalancedReply(state.history.slice(), withHint(message, turn, message), turn)\n        .then(function (parsed) {\n          state.turn = turn;\n          return showAfterDelay(recordTurn(turn, message, parsed));\n        })\n        .catch(function (err) {\n          if (state.stopped) return null;\n          // Message doesn't count: put it back so the participant can resend.\n          logError(turn, String(err && err.message ? err.message : err));\n          onRequestError(turn, String(err && err.message ? err.message : err));\n          userEl.classList.add(\"failed\");\n          setBusy(false);\n          addBubble(cfg.error_message, \"bot\", \"error\");\n          dom.input.value = message;\n          autoGrow();\n          return null;\n        });\n    }\n\n    dom.button.addEventListener(\"click\", function (e) {\n      e.preventDefault();\n      send();\n    });\n    // Enter sends; Shift+Enter adds a new line.\n    dom.input.addEventListener(\"keydown\", function (e) {\n      if (e.key === \"Enter\" && !e.shiftKey && !e.isComposing) {\n        e.preventDefault(); // stop Qualtrics from advancing the page\n        send();\n      }\n    });\n    dom.input.addEventListener(\"input\", autoGrow);\n\n    // Ignore any reply still in flight (e.g. the test page restarts the chat).\n    function stop() {\n      state.stopped = true;\n      state.done = true;\n    }\n\n    return { start: start, send: send, stop: stop, state: state, cfg: cfg, system: system };\n  }\n\n  // ---------- topic phrase for the intellectual-humility scale ----------\n  // A separate, one-off model call turns the participant's belief (\"We need more\n  // gun control\") into a neutral topic phrase (\"gun control\") to pipe into the\n  // blanks of the scale items (\"My views about ___ may change...\").\n  var TOPIC_PHRASE_PROMPT =\n    \"You will get a belief someone wrote. Reply with a short noun phrase (usually 1-3 words) naming the subject the belief is about, \" +\n    'so it reads naturally in the blank of \"My views about ___ may change with additional evidence.\" ' +\n    \"Name just the subject, in the belief's own words, and drop whatever they claim about it. \" +\n    \"If it compares two things, keep both. Don't widen it into a broader category. \" +\n    \"Leave out words like should, more, less, good, bad, better, worse or overrated. \" +\n    \"Use lowercase unless a word is a proper noun. Reply with the phrase only.\";\n  var TOPIC_PHRASE_FALLBACK = \"this topic\";\n\n  // Strips quotes, a leading \"about\" and end punctuation; rejects anything that\n  // isn't a short phrase.\n  function cleanTopicPhrase(text) {\n    var p = String(text || \"\").split(/\\r?\\n/)[0].trim()\n      .replace(/^[\"'\\u201C\\u2018]+|[\"'\\u201D\\u2019]+$/g, \"\")\n      .replace(/^about\\s+/i, \"\")\n      .replace(/[.!?;:,]+$/, \"\")\n      .trim();\n    var n = countWords(p);\n    return n >= 1 && n <= 8 ? p : \"\";\n  }\n\n  // Resolves to { phrase, ok }; never rejects. A failed or overlong answer is\n  // retried once (temperature 0 still varies a little); after that the phrase is\n  // the fallback (\"this topic\"), which still reads correctly in every item.\n  function topicPhrase(belief, cfg, fetchFn) {\n    cfg = Object.assign({}, DEFAULTS, cfg || {});\n    fetchFn = fetchFn || function (url, init) { return fetch(url, init); };\n    var fail = { phrase: TOPIC_PHRASE_FALLBACK, ok: false };\n    if (!String(belief || \"\").trim()) return Promise.resolve(fail);\n    var body = buildRequest(Object.assign({}, cfg, { temperature: 0, max_tokens: 20 }), TOPIC_PHRASE_PROMPT, [],\n      String(belief).replace(/[\\r\\n]+/g, \" \").trim());\n    function attempt() {\n      return fetchFn(cfg.proxy_url, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(body)\n      })\n        .then(function (res) { return res.ok ? res.json() : {}; })\n        .then(function (data) { return cleanTopicPhrase(data && data.text); }, function () { return \"\"; });\n    }\n    return attempt()\n      .then(function (phrase) { return phrase || attempt(); })\n      .then(function (phrase) { return phrase ? { phrase: phrase, ok: true } : fail; });\n  }\n\n  return {\n    DEFAULTS: DEFAULTS,\n    TOPIC_PHRASE_PROMPT: TOPIC_PHRASE_PROMPT,\n    cleanTopicPhrase: cleanTopicPhrase,\n    topicPhrase: topicPhrase,\n    DEFAULT_PROMPT: DEFAULT_PROMPT,\n    FORMAT_INSTRUCTIONS: FORMAT_INSTRUCTIONS,\n    fillTemplate: fillTemplate,\n    buildSystemPrompt: buildSystemPrompt,\n    buildOpeningPrompt: buildOpeningPrompt,\n    buildRequest: buildRequest,\n    parseBalancedReply: parseBalancedReply,\n    hasShifted: hasShifted,\n    CONDITIONS: CONDITIONS,\n    applyCondition: applyCondition,\n    countWords: countWords,\n    isLowEffort: isLowEffort,\n    isNoncommittal: isNoncommittal,\n    endingHint: endingHint,\n    wordBudgets: wordBudgets,\n    createChat: createChat\n  };\n})();\n\nif (typeof module !== \"undefined\" && module.exports) module.exports = BalancedChat;\n\n\nQualtrics.SurveyEngine.addOnload(function () {\n  var src = document.getElementById(\"belief-src\");\n  var belief = src ? src.textContent : \"\";\n  // Fallback first, so the items still read correctly if the call fails or the\n  // participant moves on before it returns.\n  Qualtrics.SurveyEngine.setEmbeddedData(\"topic_phrase\", \"this topic\");\n  Qualtrics.SurveyEngine.setEmbeddedData(\"topic_phrase_ok\", \"0\");\n  BalancedChat.topicPhrase(belief).then(function (r) {\n    Qualtrics.SurveyEngine.setEmbeddedData(\"topic_phrase\", r.phrase);\n    Qualtrics.SurveyEngine.setEmbeddedData(\"topic_phrase_ok\", r.ok ? \"1\" : \"0\");\n  });\n});\n", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "Language": [], "GradingData": [], "QuestionID": "QID4", "QuestionDescription": "Now, please briefly explain why you hold that belief. ${q://QID3/ChoiceTextEntryValue}"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID5", "SecondaryAttribute": "You wrote: \"${e://Field/topic}\" How much do you agree with this statement right now?", "TertiaryAttribute": null, "Payload": {"QuestionText": "You wrote: <strong>\"${e://Field/topic}\"</strong><br><br>How much do you agree with this statement right now?", "DataExportTag": "pre_agree", "QuestionType": "Slider", "Selector": "HSLIDER", "Configuration": {"QuestionDescriptionOption": "UseText", "CSSliderMin": -50, "CSSliderMax": 50, "GridLines": 10, "SnapToGrid": false, "NumDecimals": "0", "ShowValue": true, "CustomStart": false, "NotApplicable": false, "MobileFirst": true}, "Choices": {"1": {"Display": ""}}, "ChoiceOrder": ["1"], "Labels": {"1": {"Display": "-50<br>Strongly disagree"}, "2": {"Display": "+50<br>Strongly agree"}}, "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "NextChoiceId": 2, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}, "Language": [], "GradingData": [], "QuestionID": "QID5", "QuestionDescription": "You wrote: \"${e://Field/topic}\" How much do you agree with this statement right now?"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID6", "SecondaryAttribute": "How certain are you that you know what your true attitude/belief on this topic really is?", "TertiaryAttribute": null, "Payload": {"QuestionText": "How certain are you that you know what your true attitude/belief on this topic really is?", "DataExportTag": "pre_clarity", "QuestionType": "Slider", "Selector": "HSLIDER", "Configuration": {"QuestionDescriptionOption": "UseText", "CSSliderMin": 0, "CSSliderMax": 100, "GridLines": 10, "SnapToGrid": false, "NumDecimals": "0", "ShowValue": true, "CustomStart": false, "NotApplicable": false, "MobileFirst": true}, "Choices": {"1": {"Display": ""}}, "ChoiceOrder": ["1"], "Labels": {"1": {"Display": "0<br>Not certain at all"}, "2": {"Display": "100<br>Very certain"}}, "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "NextChoiceId": 2, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}, "Language": [], "GradingData": [], "QuestionID": "QID6", "QuestionDescription": "How certain are you that you know what your true attitude/belief on this topic really is?"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID7", "SecondaryAttribute": "How certain are you that your attitude/belief toward the topic is the correct attitude to have?", "TertiaryAttribute": null, "Payload": {"QuestionText": "How certain are you that your attitude/belief toward the topic is the correct attitude to have?", "DataExportTag": "pre_correct", "QuestionType": "Slider", "Selector": "HSLIDER", "Configuration": {"QuestionDescriptionOption": "UseText", "CSSliderMin": 0, "CSSliderMax": 100, "GridLines": 10, "SnapToGrid": false, "NumDecimals": "0", "ShowValue": true, "CustomStart": false, "NotApplicable": false, "MobileFirst": true}, "Choices": {"1": {"Display": ""}}, "ChoiceOrder": ["1"], "Labels": {"1": {"Display": "0<br>Not certain at all"}, "2": {"Display": "100<br>Very certain"}}, "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "NextChoiceId": 2, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}, "Language": [], "GradingData": [], "QuestionID": "QID7", "QuestionDescription": "How certain are you that your attitude/belief toward the topic is the correct attitude to have?"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID8", "SecondaryAttribute": "How important is this attitude/belief to you personally?", "TertiaryAttribute": null, "Payload": {"QuestionText": "How important is this attitude/belief to you personally?", "DataExportTag": "pre_importance", "QuestionType": "Slider", "Selector": "HSLIDER", "Configuration": {"QuestionDescriptionOption": "UseText", "CSSliderMin": 0, "CSSliderMax": 100, "GridLines": 10, "SnapToGrid": false, "NumDecimals": "0", "ShowValue": true, "CustomStart": false, "NotApplicable": false, "MobileFirst": true}, "Choices": {"1": {"Display": ""}}, "ChoiceOrder": ["1"], "Labels": {"1": {"Display": "0<br>Not at all important"}, "2": {"Display": "100<br>Extremely important"}}, "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "NextChoiceId": 2, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}, "Language": [], "GradingData": [], "QuestionID": "QID8", "QuestionDescription": "How important is this attitude/belief to you personally?"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID9", "SecondaryAttribute": "How knowledgeable are you about this attitude/belief?", "TertiaryAttribute": null, "Payload": {"QuestionText": "How knowledgeable are you about this attitude/belief?", "DataExportTag": "pre_knowledge", "QuestionType": "Slider", "Selector": "HSLIDER", "Configuration": {"QuestionDescriptionOption": "UseText", "CSSliderMin": 0, "CSSliderMax": 100, "GridLines": 10, "SnapToGrid": false, "NumDecimals": "0", "ShowValue": true, "CustomStart": false, "NotApplicable": false, "MobileFirst": true}, "Choices": {"1": {"Display": ""}}, "ChoiceOrder": ["1"], "Labels": {"1": {"Display": "0<br>Not at all knowledgeable"}, "2": {"Display": "100<br>Extremely knowledgeable"}}, "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "NextChoiceId": 2, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}, "Language": [], "GradingData": [], "QuestionID": "QID9", "QuestionDescription": "How knowledgeable are you about this attitude/belief?"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID10", "SecondaryAttribute": "How committed are you to this attitude/belief?", "TertiaryAttribute": null, "Payload": {"QuestionText": "How committed are you to this attitude/belief?", "DataExportTag": "pre_commit", "QuestionType": "Slider", "Selector": "HSLIDER", "Configuration": {"QuestionDescriptionOption": "UseText", "CSSliderMin": 0, "CSSliderMax": 100, "GridLines": 10, "SnapToGrid": false, "NumDecimals": "0", "ShowValue": true, "CustomStart": false, "NotApplicable": false, "MobileFirst": true}, "Choices": {"1": {"Display": ""}}, "ChoiceOrder": ["1"], "Labels": {"1": {"Display": "0<br>Not at all committed"}, "2": {"Display": "100<br>Extremely committed"}}, "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "NextChoiceId": 2, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}, "Language": [], "GradingData": [], "QuestionID": "QID10", "QuestionDescription": "How committed are you to this attitude/belief?"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID11", "SecondaryAttribute": "Thank you, you will now participate in a conversation with an AI chatbot about your attitude/belief.", "TertiaryAttribute": null, "Payload": {"QuestionText": "Thank you, you will now participate in a conversation with an AI chatbot about your attitude/belief. You are welcome to share your opinions, ask questions, debate the AI, or engage in any form of discussion as long as it remains centered on the attitude/belief.<br><br>Your participation is most useful if you engage with the AI as naturally as possible. After about 14 messages (7 from you and 7 from the chatbot), the chatbot will automatically move to the next page of the survey. Don't worry if this cuts off your conversation. Just keep chatting until the page advances.", "DataExportTag": "chat_instructions", "QuestionType": "DB", "Selector": "TB", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "NextChoiceId": 1, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "Language": [], "GradingData": [], "QuestionID": "QID11", "QuestionDescription": "Thank you, you will now participate in a conversation with an AI chatbot about your attitude/belief."}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID12", "SecondaryAttribute": "Send", "TertiaryAttribute": null, "Payload": {"QuestionText": "<div id=\"chat-container\">\n<div id=\"chat-history-1\"></div>\n<div id=\"chat-input\"><textarea rows=\"1\" placeholder=\"Type your message here...\" id=\"message-input-1\" autocomplete=\"off\"></textarea><button id=\"send-button-1\">Send</button></div>\n</div>", "DataExportTag": "chat", "QuestionType": "DB", "Selector": "TB", "ChoiceOrder": [], "Validation": {"Settings": {"Type": "None"}}, "NextChoiceId": 1, "NextAnswerId": 1, "QuestionJS": "/*\n * Balanced (\"even-handed\") chatbot engine.\n *\n * The bot is a conversation partner first: the model writes each reply as a\n * natural message, and weaves into it ONE point that supports the participant's\n * current leaning and ONE that challenges it. The model also reports those two\n * points separately (JSON), so every turn's balance can be checked and logged.\n *\n * No imports and no build step: this file can be pasted verbatim at the top of a\n * Qualtrics question's JavaScript (see qualtrics/README.md). It is also loaded by\n * the standalone test page (index.html) and by the Node tests.\n */\nvar BalancedChat = (function () {\n  \"use strict\";\n\n  // One shared prompt for all bots (the researcher's wording, no examples). Only\n  // {condition_rules} differs between the balanced, congenial and uncongenial\n  // conditions. Question endings, the side reminder and the \"idk\" stance rule\n  // are handled in code (withHint, recordTurn).\n  var DEFAULT_PROMPT = [\n    'You\\'re chatting with someone who believes \"{topic}\". Why, in their words: \"{p_response}\".',\n    \"Talk like a friendly person texting: casual, 2-3 short sentences (25-40 words, never over {word_limit}). Reply directly to what they just said and keep it about the topic.\",\n    \"Don't open by agreeing with or praising them (\\\"exactly\\\", \\\"totally\\\", \\\"great point\\\").\",\n    \"Don't repeat a point or a question you've already used.\",\n    \"If they're brief or uninterested, keep it short and casual; never treat the chat like an assignment.\",\n    \"{condition_rules}\"\n  ].join(\"\\n\");\n\n  // Always appended after the prompt: the code needs this reply format to show the\n  // message and log stance/support/dissent. Not part of the editable prompt.\n  var FORMAT_INSTRUCTIONS = [\n    'Reply ONLY with JSON: {\"stance\":\"\",\"message\":\"\",\"support\":\"\",\"dissent\":\"\"}',\n    'stance: \"original\", \"shifted\" (now leaning the other way) or \"mixed\". message: what they\\'ll read. support / dissent: a few words naming the point you made for / against their view (leave one empty if there\\'s none).'\n  ].join(\"\\n\");\n\n  // The only part of the prompt that differs between conditions.\n  var CONDITIONS = {\n    balanced: {\n      rules: [\n        \"Be even-handed in the way you discuss the topic. In every message, naturally work in one point for the view they lean toward now and one point against it.\",\n        \"If they move toward the other side, continue to be even-handed: back their new view and also suggest backing for the alternative side.\"\n      ].join(\"\\n\"),\n      examples: \"\",\n      rewrite: \"keeping one point for and one against\"\n    },\n    congenial: {\n      rules: \"In every message, naturally work in one point that supports their view. You can briefly acknowledge the other side, but every message should land in support of their view.\",\n      examples: \"\",\n      rewrite: \"keeping the point that supports their view\"\n    },\n    uncongenial: {\n      rules: \"In every message, naturally work in one point that challenges their view. You can briefly acknowledge what they said, but every message should land against their view.\",\n      examples: \"\",\n      rewrite: \"keeping the point that challenges their view\"\n    }\n  };\n\n  function conditionOf(cfg) {\n    return CONDITIONS[cfg && cfg.condition] ? cfg.condition : \"balanced\";\n  }\n\n  var DEFAULT_OPENING_PROMPT =\n    'Here is what the participant wrote about why they hold their view: \"{p_response}\". ' +\n    \"Start the conversation by reacting to it, in the JSON format.\";\n\n  var DEFAULTS = {\n    proxy_url: \"https://balanced-chat-proxy.bthall3.workers.dev/\",\n    model: \"gpt-5.6-luna\",\n    reasoning_effort: \"none\", // reasoning models: \"none\" keeps replies fast and allows temperature\n    temperature: 0.5,\n    max_tokens: 300,\n    word_limit: 60,\n    max_messages: 7,\n    // \"balanced\" (for + against their current leaning) | \"congenial\" (supports their\n    // original view) | \"uncongenial\" (challenges their original view)\n    condition: \"balanced\",\n    delay_ms_per_word: 200,\n    max_delay_ms: 8000,\n    request_timeout_ms: 20000,\n    prompt_template: DEFAULT_PROMPT,\n    opening_template: DEFAULT_OPENING_PROMPT,\n    // If a message is over word_limit, ask the model once for a shorter rewrite;\n    // if it is still too long it is shown anyway and flagged (over_limit).\n    enforce_word_limit: true,\n    // The code decides whether each reply ends with a question (the model, left to\n    // itself, either always or never asks one): the opening and even turns ask,\n    // odd turns end on a statement, and a low-effort participant message always\n    // gets an easy question. The hint goes to the model only, not into history.\n    alternate_questions: true,\n    question_hint: \"(For this reply: end with one short, easy question about the topic in general, not about their own life or routine, and different from any question you've asked so far.)\",\n    statement_hint: \"(For this reply: end on a statement, not a question.)\",\n    // Directional bots drift toward the middle late in a chat, so every request\n    // repeats which side to land on (sent with the request only, like the hints above).\n    side_hint_congenial: \"(Your point should land in support of their original view: \\\"{topic}\\\".)\",\n    side_hint_uncongenial: \"(Your point should land against their original view: \\\"{topic}\\\".)\",\n    // Directional bots only: a second, quick model call grades each message as\n    // FOR / AGAINST / NEITHER the original view while it is being shown. If it\n    // landed on the wrong side, the next request swaps the side reminder for this\n    // correction ({drift} says how the last message came across).\n    direction_check: true,\n    direction_fix_hint_congenial: \"(Your last message came across as {drift}. Make sure this one lands in support of their original view: \\\"{topic}\\\".)\",\n    direction_fix_hint_uncongenial: \"(Your last message came across as {drift}. Make sure this one lands against their original view: \\\"{topic}\\\".)\",\n    closing_message: \"Thank you for the conversation! We will now move on to the next part of the study.\",\n    error_message: \"Sorry, something went wrong. Please send your message again.\",\n    opening_fallback: \"Thanks for sharing your view. What would you like to discuss about this topic?\"\n  };\n\n  // Only known placeholders are filled, so JSON braces in the template are left alone.\n  // ack/reply/point/question_words are kept so older saved prompts still fill in.\n  function fillTemplate(template, vars) {\n    return String(template).replace(/\\{(topic|p_response|drift|word_limit|ack_words|reply_words|point_words|soft_words|question_words)\\}/g, function (m, key) {\n      var v = vars[key];\n      return v === undefined || v === null ? \"\" : String(v).replace(/[\\r\\n]+/g, \" \").trim();\n    });\n  }\n\n  // Legacy placeholders for older custom prompts (e.g. {soft_words}).\n  function wordBudgets(cfg) {\n    var limit = parseInt(cfg.word_limit, 10) || 50;\n    return {\n      word_limit: limit,\n      soft_words: Math.max(Math.floor(limit * 0.2), 5),\n      ack_words: 0,\n      reply_words: Math.floor(limit * 0.2),\n      point_words: Math.floor(limit * 0.3),\n      question_words: Math.floor(limit * 0.2)\n    };\n  }\n\n  function templateVars(cfg, vars) {\n    var b = wordBudgets(cfg);\n    b.topic = vars.topic;\n    b.p_response = vars.p_response;\n    return b;\n  }\n\n  // Drop the condition's rules and examples into the shared template, then fill\n  // the remaining placeholders (the rules themselves use {soft_words}).\n  function applyCondition(template, cfg) {\n    var c = CONDITIONS[conditionOf(cfg)];\n    return String(template)\n      .replace(\"{condition_rules}\", function () { return c.rules; })\n      .replace(\"{examples}\", function () { return c.examples; });\n  }\n\n  function buildSystemPrompt(cfg, vars) {\n    var prompt = fillTemplate(applyCondition(cfg.prompt_template, cfg), templateVars(cfg, vars)).trim();\n    return prompt + \"\\n\\n\" + FORMAT_INSTRUCTIONS;\n  }\n\n  function buildOpeningPrompt(cfg, vars) {\n    return fillTemplate(cfg.opening_template, templateVars(cfg, vars));\n  }\n\n  // Same body shape the launched Qualtrics arms send to the proxy, plus reasoning_effort.\n  function buildRequest(cfg, system, history, prompt) {\n    return {\n      prompt: prompt,\n      system: system,\n      history: history,\n      model: cfg.model,\n      temperature: Number(cfg.temperature),\n      max_tokens: parseInt(cfg.max_tokens, 10),\n      reasoning_effort: cfg.reasoning_effort\n    };\n  }\n\n  function asText(v) {\n    return typeof v === \"string\" ? v.trim() : \"\";\n  }\n\n  var STANCES = [\"original\", \"shifted\", \"mixed\"];\n\n  // Has the participant moved toward the other side? Then the bot follows them.\n  function hasShifted(parts) {\n    return !!parts && (parts.stance === \"shifted\" || parts.stance === \"mixed\");\n  }\n\n  // Accepts clean JSON, ```json fenced``` JSON, or JSON surrounded by prose.\n  // What a valid turn must contain depends on the condition: balanced needs both\n  // considerations; congenial needs one supporting, uncongenial one challenging\n  // the participant's original view.\n  function parseBalancedReply(text, condition) {\n    var raw = typeof text === \"string\" ? text : \"\";\n    var start = raw.indexOf(\"{\");\n    var end = raw.lastIndexOf(\"}\");\n    if (start === -1 || end <= start) return { ok: false, parts: null, raw: raw };\n    var obj;\n    var body = raw.slice(start, end + 1);\n    try {\n      obj = JSON.parse(body);\n    } catch (e) {\n      // The model sometimes closes with a stray comma or quote: ...\"dissent\":\"x\",\"}\n      try {\n        obj = JSON.parse(body.replace(/,\\s*\"?\\s*\\}$/, \"}\"));\n      } catch (e2) {\n        return { ok: false, parts: null, raw: raw };\n      }\n    }\n    var stance = asText(obj.stance).toLowerCase();\n    var parts = {\n      stance: STANCES.indexOf(stance) !== -1 ? stance : \"\",\n      message: asText(obj.message),\n      support: asText(obj.support),\n      dissent: asText(obj.dissent)\n    };\n    // A turn counts as balanced only if the model wrote a message and reports\n    // both a supporting and a challenging consideration woven into it.\n    var cond = CONDITIONS[condition] ? condition : \"balanced\";\n    // Directional bots may briefly acknowledge the other side (it can show up in\n    // the other field); what matters is that their own consideration is there.\n    var ok = !!parts.message && (\n      cond === \"congenial\" ? !!parts.support :\n      cond === \"uncongenial\" ? !!parts.dissent :\n      !!parts.support && !!parts.dissent\n    );\n    return { ok: ok, parts: parts, raw: raw };\n  }\n\n  function countWords(text) {\n    return String(text || \"\").split(/\\s+/).filter(Boolean).length;\n  }\n\n  // \"idk\", \"maybe\", \"ok cool\", \"probably emergencies mostly\": a disengaged reply.\n  var LOW_EFFORT = /^(idk|i\\s*d(on'?t|unno)\\s*know|dunno|maybe|i guess|guess so|ok(ay)?|k|sure|yeah?|yea|ya|yep|nah|no|whatever|fine|lol|cool|true|same)\\b/i;\n\n  function isLowEffort(message) {\n    var m = String(message || \"\").trim();\n    var n = countWords(m);\n    return n <= 5 || (n <= 10 && LOW_EFFORT.test(m));\n  }\n\n  // Pure filler (\"idk\", \"maybe\", \"yeah probably\", \"i guess\"): no position taken.\n  // Narrower than isLowEffort, so a short concession like \"ok you're right\" is\n  // still read as a possible shift.\n  var FILLER = (\"idk i dunno dont don't know maybe guess so not sure ok okay k whatever lol cool eh meh \" +\n    \"hmm probably possibly perhaps kinda sorta yeah ya yea yep im i'm tired\").split(\" \");\n\n  function isNoncommittal(message) {\n    var words = String(message || \"\").toLowerCase().replace(/[^a-z' ]+/g, \" \").split(/\\s+/).filter(Boolean);\n    return words.length > 0 && words.length <= 6 && words.every(function (w) { return FILLER.indexOf(w) !== -1; });\n  }\n\n  // Which ending this reply should have: the opening and even turns ask a\n  // question, odd turns end on a statement, and a low-effort reply always gets\n  // an easy question so the participant has something simple to answer.\n  function endingHint(cfg, turn, participantMessage) {\n    if (!cfg.alternate_questions) return \"\";\n    var ask = turn === 0 || turn % 2 === 0 || isLowEffort(participantMessage);\n    return ask ? cfg.question_hint : cfg.statement_hint;\n  }\n\n  /*\n   * opts:\n   *   cfg      - settings (missing keys fall back to DEFAULTS)\n   *   vars     - { topic, p_response }: the participant's belief and why they hold it\n   *   store    - { set(key, value) }  (Qualtrics: setEmbeddedData)\n   *   dom      - { history, input, button } elements\n   *   fetch    - optional fetch implementation (tests / mock mode)\n   *   onBotReply(record) - called after each bot turn is shown\n   *   onDone()           - called after the closing message\n   *   onRequestError(turn, message) - called when a request fails\n   *   setTimeout         - optional timer (tests)\n   */\n  function createChat(opts) {\n    var cfg = {};\n    var k;\n    for (k in DEFAULTS) cfg[k] = DEFAULTS[k];\n    for (k in opts.cfg || {}) if (opts.cfg[k] !== undefined && opts.cfg[k] !== \"\") cfg[k] = opts.cfg[k];\n\n    var vars = opts.vars || {};\n    var store = opts.store || { set: function () {} };\n    var dom = opts.dom;\n    var fetchFn = opts.fetch || function (url, init) { return fetch(url, init); };\n    var timer = opts.setTimeout || setTimeout;\n    var onBotReply = opts.onBotReply || function () {};\n    var onDone = opts.onDone || function () {};\n    var onRequestError = opts.onRequestError || function () {};\n    var maxMessages = parseInt(cfg.max_messages, 10);\n\n    var condition = conditionOf(cfg);\n    var system = buildSystemPrompt(cfg, vars);\n    var state = { history: [], turn: 0, busy: false, done: false, stopped: false, records: [], errors: {} };\n    var typingEl = null;\n\n    function addBubble(text, who, extraClass) {\n      var el = document.createElement(\"div\");\n      el.classList.add(\"message\", who === \"user\" ? \"user-message\" : \"bot-message\");\n      if (extraClass) el.classList.add(extraClass);\n      el.textContent = text;\n      dom.history.appendChild(el);\n      dom.history.scrollTop = dom.history.scrollHeight;\n      return el;\n    }\n\n    function setBusy(busy) {\n      state.busy = busy;\n      var locked = busy || state.done;\n      dom.input.disabled = locked;\n      dom.button.disabled = locked;\n      if (busy && !typingEl) {\n        typingEl = addBubble(\"typing…\", \"bot\", \"typing\");\n      } else if (!busy && typingEl) {\n        typingEl.parentNode.removeChild(typingEl);\n        typingEl = null;\n      }\n      if (!locked) dom.input.focus();\n    }\n\n    function logError(turn, message) {\n      state.errors[turn] = (state.errors[turn] ? state.errors[turn] + \" | \" : \"\") + message;\n      store.set(\"error_\" + turn, state.errors[turn]);\n    }\n\n    // One proxy call with a timeout. Resolves to the model's text.\n    // `over` replaces request fields (system, temperature, max_tokens), e.g. for the direction check.\n    function callProxy(history, prompt, over) {\n      var controller = typeof AbortController !== \"undefined\" ? new AbortController() : null;\n      var t = timer(function () { if (controller) controller.abort(); }, cfg.request_timeout_ms);\n      var body = buildRequest(cfg, system, history, prompt);\n      for (var key in over || {}) body[key] = over[key];\n      return fetchFn(cfg.proxy_url, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(body),\n        signal: controller ? controller.signal : undefined\n      })\n        .then(function (res) {\n          if (!res.ok) {\n            // Surface the proxy's { error } message, e.g. a bad model name or missing key.\n            return res.json().catch(function () { return {}; }).then(function (d) {\n              throw new Error(\"HTTP \" + res.status + (d && d.error ? \": \" + d.error : \"\"));\n            });\n          }\n          return res.json();\n        })\n        .then(function (data) {\n          clearTimeout(t);\n          if (!data || typeof data.text !== \"string\" || !data.text.trim()) {\n            throw new Error(\"Empty response\" + (data && data.error ? \": \" + JSON.stringify(data.error) : \"\"));\n          }\n          return data.text;\n        }, function (err) {\n          clearTimeout(t);\n          throw err;\n        });\n    }\n\n    function finalize(history, prompt, parsed, turn) {\n      return Promise.resolve(enforceLimit(history, prompt, parsed, turn));\n    }\n\n    var WANT = { congenial: \"FOR\", uncongenial: \"AGAINST\" };\n    var DRIFT = { FOR: \"supporting their original view\", AGAINST: \"against their original view\", NEITHER: \"neutral or in the middle\" };\n\n    // Second model call: does this message land FOR, AGAINST or NEITHER the\n    // participant's original view? Resolves to \"\" if the check itself fails.\n    function judgeDirection(message) {\n      var judgeSystem =\n        'You check one chatbot message from a conversation with someone who believes \"' + clean(vars.topic) + '\". ' +\n        \"Taken as a whole, does the message land FOR that belief, AGAINST it, or NEITHER (balanced, neutral or unclear)? \" +\n        \"Answer with one word: FOR, AGAINST or NEITHER.\";\n      return callProxy([], message, { system: judgeSystem, temperature: 0, max_tokens: 10 })\n        .then(function (text) {\n          var m = /\\b(FOR|AGAINST|NEITHER)\\b/i.exec(text);\n          return m ? m[1].toUpperCase() : \"\";\n        }, function () { return \"\"; });\n    }\n\n    function clean(v) {\n      return String(v == null ? \"\" : v).replace(/[\\r\\n]+/g, \" \").trim();\n    }\n\n    // Grades the message just shown; the verdict steers the next reply (see withHint).\n    // Nothing is rewritten, so the check adds no wait beyond the typing delay.\n    function checkDirection(record) {\n      if (!WANT[condition] || !cfg.direction_check || !record.parse_ok) return Promise.resolve();\n      return judgeDirection(record.shown).then(function (verdict) {\n        record.direction = verdict;\n        store.set(\"direction_\" + record.turn, verdict);\n        if (verdict && verdict !== WANT[condition]) logError(record.turn, \"direction check: \" + verdict + \", next reply steered back\");\n      });\n    }\n\n    // Calls the model. An unreadable reply is retried once as-is; a readable one\n    // that points the wrong way for the condition gets one targeted repair request.\n    function getBalancedReply(history, prompt, turn) {\n      return callProxy(history, prompt).then(function (text) {\n        var parsed = parseBalancedReply(text, condition);\n        if (parsed.ok) return finalize(history, prompt, parsed, turn);\n        var readable = parsed.parts && parsed.parts.message;\n        var retryHistory = readable\n          ? history.concat([{ role: \"user\", content: prompt }, { role: \"assistant\", content: parsed.raw }])\n          : history;\n        var retryPrompt = readable ? repairPrompt(parsed.parts) : prompt;\n        logError(turn, readable ? \"wrong direction for condition, asked for repair\" : \"unparseable reply, retried\");\n        return callProxy(retryHistory, retryPrompt).then(function (text2) {\n          var parsed2 = parseBalancedReply(text2, condition);\n          if (parsed2.ok) return finalize(history, prompt, parsed2, turn);\n          return parsed2.parts && parsed2.parts.message ? parsed2 : readable ? parsed : parsed2;\n        });\n      });\n    }\n\n    // Names what's missing from a readable reply so the rewrite can fix just that.\n    function repairPrompt(parts) {\n      var needed = condition === \"congenial\" ? \"a consideration that supports their original view\"\n        : condition === \"uncongenial\" ? \"a consideration that challenges their original view\"\n        : !parts.support ? \"a consideration that supports their current leaning\" : \"a consideration that challenges it\";\n      var fix = \"Your message was missing \" + needed + \". Rewrite it with that woven in.\";\n      return fix + \" Keep the same tone and length. Respond ONLY with the JSON.\";\n    }\n\n    // Over the limit: ask once for a shorter rewrite. Free prose can't be cut\n    // safely, so if it is still too long, the shorter version is shown and the\n    // turn is flagged.\n    function enforceLimit(history, prompt, parsed, turn) {\n      var limit = parseInt(cfg.word_limit, 10);\n      var words = countWords(parsed.parts.message);\n      if (!cfg.enforce_word_limit || !limit || words <= limit) return parsed;\n\n      var rewriteHistory = history.concat(\n        [{ role: \"user\", content: prompt }, { role: \"assistant\", content: parsed.raw }]\n      );\n      var rewritePrompt =\n        \"That message was \" + words + \" words; the limit is \" + limit + \". Rewrite it shorter, keeping it \" +\n        \"conversational and \" + CONDITIONS[condition].rewrite + \". \" +\n        \"Respond ONLY with the JSON.\";\n      logError(turn, \"over word limit (\" + words + \"), asked for rewrite\");\n\n      function keep(p) {\n        if (countWords(p.parts.message) > limit) logError(turn, \"still over word limit after rewrite\");\n        return p;\n      }\n\n      return callProxy(rewriteHistory, rewritePrompt).then(function (text) {\n        var again = parseBalancedReply(text, condition);\n        if (!again.ok) return keep(parsed);\n        return keep(countWords(again.parts.message) < words ? again : parsed);\n      }, function () {\n        return keep(parsed);\n      });\n    }\n\n    function recordTurn(turn, userMessage, parsed) {\n      // Invalid for the condition but readable: show the model's message (the turn\n      // is flagged parse_ok 0), never the raw JSON. Unreadable: show the raw text.\n      var readable = parsed.parts && parsed.parts.message;\n      var shown = parsed.ok ? parsed.parts.message : readable ? parsed.parts.message : parsed.raw.trim();\n      // \"idk\" / \"maybe\" is not a change of mind: keep the previous stance even if\n      // the model read it as one.\n      var prev = null;\n      for (var i = state.records.length - 1; i >= 0 && !prev; i--) {\n        if (state.records[i].stance) prev = state.records[i].stance;\n      }\n      var overridden = 0;\n      if (readable && turn > 0 && prev && isNoncommittal(userMessage) && parsed.parts.stance !== prev) {\n        parsed.parts.stance = prev;\n        overridden = 1;\n      }\n      var record = {\n        turn: turn,\n        user: userMessage,\n        shown: shown,\n        parts: parsed.parts,\n        raw: parsed.raw,\n        stance: readable ? parsed.parts.stance : \"\",\n        stance_overridden: overridden,\n        direction: \"\",\n        parse_ok: parsed.ok ? 1 : 0,\n        words: countWords(shown),\n        over_limit: countWords(shown) > parseInt(cfg.word_limit, 10) ? 1 : 0\n      };\n      if (turn > 0) store.set(\"msg_\" + turn, userMessage);\n      store.set(\"response_\" + turn, shown);\n      store.set(\"support_\" + turn, readable ? parsed.parts.support : \"\");\n      store.set(\"dissent_\" + turn, readable ? parsed.parts.dissent : \"\");\n      store.set(\"stance_\" + turn, record.stance);\n      if (WANT[condition]) store.set(\"direction_\" + turn, record.direction);\n      store.set(\"parse_ok_\" + turn, String(record.parse_ok));\n      store.set(\"words_\" + turn, String(record.words));\n      state.records.push(record);\n      // Keep the JSON in history so the model keeps answering in JSON.\n      if (turn > 0) state.history.push({ role: \"user\", content: userMessage });\n      state.history.push({\n        role: \"assistant\",\n        content: parsed.ok ? JSON.stringify(parsed.parts) : parsed.raw\n      });\n      return record;\n    }\n\n    // The direction check runs during the typing delay; the bubble waits for both.\n    function showAfterDelay(record) {\n      var delay = Math.min(countWords(record.shown) * Number(cfg.delay_ms_per_word || 0), cfg.max_delay_ms);\n      var checked = checkDirection(record);\n      return new Promise(function (resolve) {\n        timer(function () { checked.then(go, go); }, delay);\n        function go() {\n          if (state.stopped) return resolve(null);\n          setBusy(false);\n          addBubble(record.shown, \"bot\");\n          onBotReply(record);\n          resolve(record);\n        }\n      });\n    }\n\n    // The ending instruction rides along in the request only; history keeps the\n    // participant's actual words.\n    function withHint(prompt, turn, participantMessage) {\n      var last = state.records[state.records.length - 1];\n      var drifted = last && last.direction && WANT[condition] && last.direction !== WANT[condition];\n      var sideKey = (drifted ? \"direction_fix_hint_\" : \"side_hint_\") + condition;\n      var side = cfg[sideKey] ? fillTemplate(cfg[sideKey], { topic: vars.topic, drift: drifted ? DRIFT[last.direction] : \"\" }) : \"\";\n      var hints = [side, endingHint(cfg, turn, participantMessage)].filter(function (h) { return h; });\n      return hints.length ? prompt + \"\\n\\n\" + hints.join(\" \") : prompt;\n    }\n\n    function start() {\n      setBusy(true);\n      return getBalancedReply([], withHint(buildOpeningPrompt(cfg, vars), 0, \"\"), 0)\n        .then(function (parsed) {\n          return showAfterDelay(recordTurn(0, \"\", parsed));\n        })\n        .catch(function (err) {\n          if (state.stopped) return null;\n          logError(0, String(err && err.message ? err.message : err));\n          onRequestError(0, String(err && err.message ? err.message : err));\n          var record = recordTurn(0, \"\", { ok: false, parts: null, raw: cfg.opening_fallback });\n          setBusy(false);\n          addBubble(record.shown, \"bot\");\n          onBotReply(record);\n          return record;\n        });\n    }\n\n    function finish(message, turn) {\n      state.turn = turn;\n      store.set(\"msg_\" + turn, message);\n      state.done = true;\n      setBusy(false);\n      addBubble(cfg.closing_message, \"bot\", \"closing\");\n      onDone();\n    }\n\n    // Grow the message box with its content (CSS max-height caps it; then it scrolls).\n    function autoGrow() {\n      var el = dom.input;\n      if (!el.style || el.tagName !== \"TEXTAREA\") return;\n      el.style.height = \"auto\";\n      el.style.height = el.scrollHeight + (el.offsetHeight - el.clientHeight) + \"px\";\n    }\n\n    function send() {\n      if (state.busy || state.done) return Promise.resolve(null);\n      var message = (dom.input.value || \"\").trim();\n      if (!message) return Promise.resolve(null);\n      var turn = state.turn + 1;\n      dom.input.value = \"\";\n      autoGrow();\n      var userEl = addBubble(message, \"user\");\n\n      // Last participant message: no API call, so a failed request can't strand anyone.\n      if (turn >= maxMessages) {\n        finish(message, turn);\n        return Promise.resolve(null);\n      }\n\n      setBusy(true);\n      return getBalancedReply(state.history.slice(), withHint(message, turn, message), turn)\n        .then(function (parsed) {\n          state.turn = turn;\n          return showAfterDelay(recordTurn(turn, message, parsed));\n        })\n        .catch(function (err) {\n          if (state.stopped) return null;\n          // Message doesn't count: put it back so the participant can resend.\n          logError(turn, String(err && err.message ? err.message : err));\n          onRequestError(turn, String(err && err.message ? err.message : err));\n          userEl.classList.add(\"failed\");\n          setBusy(false);\n          addBubble(cfg.error_message, \"bot\", \"error\");\n          dom.input.value = message;\n          autoGrow();\n          return null;\n        });\n    }\n\n    dom.button.addEventListener(\"click\", function (e) {\n      e.preventDefault();\n      send();\n    });\n    // Enter sends; Shift+Enter adds a new line.\n    dom.input.addEventListener(\"keydown\", function (e) {\n      if (e.key === \"Enter\" && !e.shiftKey && !e.isComposing) {\n        e.preventDefault(); // stop Qualtrics from advancing the page\n        send();\n      }\n    });\n    dom.input.addEventListener(\"input\", autoGrow);\n\n    // Ignore any reply still in flight (e.g. the test page restarts the chat).\n    function stop() {\n      state.stopped = true;\n      state.done = true;\n    }\n\n    return { start: start, send: send, stop: stop, state: state, cfg: cfg, system: system };\n  }\n\n  // ---------- topic phrase for the intellectual-humility scale ----------\n  // A separate, one-off model call turns the participant's belief (\"We need more\n  // gun control\") into a neutral topic phrase (\"gun control\") to pipe into the\n  // blanks of the scale items (\"My views about ___ may change...\").\n  var TOPIC_PHRASE_PROMPT =\n    \"You will get a belief someone wrote. Reply with a short noun phrase (usually 1-3 words) naming the subject the belief is about, \" +\n    'so it reads naturally in the blank of \"My views about ___ may change with additional evidence.\" ' +\n    \"Name just the subject, in the belief's own words, and drop whatever they claim about it. \" +\n    \"If it compares two things, keep both. Don't widen it into a broader category. \" +\n    \"Leave out words like should, more, less, good, bad, better, worse or overrated. \" +\n    \"Use lowercase unless a word is a proper noun. Reply with the phrase only.\";\n  var TOPIC_PHRASE_FALLBACK = \"this topic\";\n\n  // Strips quotes, a leading \"about\" and end punctuation; rejects anything that\n  // isn't a short phrase.\n  function cleanTopicPhrase(text) {\n    var p = String(text || \"\").split(/\\r?\\n/)[0].trim()\n      .replace(/^[\"'\\u201C\\u2018]+|[\"'\\u201D\\u2019]+$/g, \"\")\n      .replace(/^about\\s+/i, \"\")\n      .replace(/[.!?;:,]+$/, \"\")\n      .trim();\n    var n = countWords(p);\n    return n >= 1 && n <= 8 ? p : \"\";\n  }\n\n  // Resolves to { phrase, ok }; never rejects. A failed or overlong answer is\n  // retried once (temperature 0 still varies a little); after that the phrase is\n  // the fallback (\"this topic\"), which still reads correctly in every item.\n  function topicPhrase(belief, cfg, fetchFn) {\n    cfg = Object.assign({}, DEFAULTS, cfg || {});\n    fetchFn = fetchFn || function (url, init) { return fetch(url, init); };\n    var fail = { phrase: TOPIC_PHRASE_FALLBACK, ok: false };\n    if (!String(belief || \"\").trim()) return Promise.resolve(fail);\n    var body = buildRequest(Object.assign({}, cfg, { temperature: 0, max_tokens: 20 }), TOPIC_PHRASE_PROMPT, [],\n      String(belief).replace(/[\\r\\n]+/g, \" \").trim());\n    function attempt() {\n      return fetchFn(cfg.proxy_url, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(body)\n      })\n        .then(function (res) { return res.ok ? res.json() : {}; })\n        .then(function (data) { return cleanTopicPhrase(data && data.text); }, function () { return \"\"; });\n    }\n    return attempt()\n      .then(function (phrase) { return phrase || attempt(); })\n      .then(function (phrase) { return phrase ? { phrase: phrase, ok: true } : fail; });\n  }\n\n  return {\n    DEFAULTS: DEFAULTS,\n    TOPIC_PHRASE_PROMPT: TOPIC_PHRASE_PROMPT,\n    cleanTopicPhrase: cleanTopicPhrase,\n    topicPhrase: topicPhrase,\n    DEFAULT_PROMPT: DEFAULT_PROMPT,\n    FORMAT_INSTRUCTIONS: FORMAT_INSTRUCTIONS,\n    fillTemplate: fillTemplate,\n    buildSystemPrompt: buildSystemPrompt,\n    buildOpeningPrompt: buildOpeningPrompt,\n    buildRequest: buildRequest,\n    parseBalancedReply: parseBalancedReply,\n    hasShifted: hasShifted,\n    CONDITIONS: CONDITIONS,\n    applyCondition: applyCondition,\n    countWords: countWords,\n    isLowEffort: isLowEffort,\n    isNoncommittal: isNoncommittal,\n    endingHint: endingHint,\n    wordBudgets: wordBudgets,\n    createChat: createChat\n  };\n})();\n\nif (typeof module !== \"undefined\" && module.exports) module.exports = BalancedChat;\n\n\nQualtrics.SurveyEngine.addOnload(function () {\n  this.hideNextButton(); // auto-advance handles page progression\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n  var q = this;\n\n  function ed(key) {\n    return (Qualtrics.SurveyEngine.getEmbeddedData(key) || \"\").replace(/[\\r\\n]+/g, \" \").trim();\n  }\n\n  // Copy any settings you changed on the test page here. Anything left out uses\n  // BalancedChat.DEFAULTS (model, prompt_template, word_limit, ...).\n  // Set them here, not via embedded data: the launched flow's \"GPT-4.1 nano\"\n  // value is not a valid model ID, and gpt-4.1-nano shuts down Oct 23, 2026.\n  // Requires the balanced-chat-proxy worker (proxy/README.md).\n  var cfg = {\n    max_messages: 7\n  };\n\n  // One script for all three arms: the survey flow sets `cond` to balanced,\n  // congenial or uncongenial. Anything else falls back to balanced.\n  var cond = ed(\"cond\");\n  cfg.condition = BalancedChat.CONDITIONS[cond] ? cond : \"balanced\";\n\n  var chat = BalancedChat.createChat({\n    cfg: cfg,\n    vars: { topic: ed(\"topic\"), p_response: ed(\"p_response\") },\n    store: {\n      set: function (key, value) { Qualtrics.SurveyEngine.setEmbeddedData(key, value); }\n    },\n    dom: {\n      history: document.getElementById(\"chat-history-1\"),\n      input: document.getElementById(\"message-input-1\"),\n      button: document.getElementById(\"send-button-1\")\n    },\n    onDone: function () {\n      setTimeout(function () { q.clickNextButton(); }, 5000);\n    }\n  });\n  chat.start();\n});\n", "DataVisibility": {"Private": false, "Hidden": false}, "Configuration": {"QuestionDescriptionOption": "UseText"}, "Language": [], "GradingData": [], "QuestionID": "QID12", "QuestionDescription": "Send"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID13", "SecondaryAttribute": "Earlier, you wrote: \"${e://Field/topic}\" How much do you agree with this statement right now?", "TertiaryAttribute": null, "Payload": {"QuestionText": "Earlier, you wrote: <strong>\"${e://Field/topic}\"</strong><br><br>How much do you agree with this statement right now?", "DataExportTag": "post_agree", "QuestionType": "Slider", "Selector": "HSLIDER", "Configuration": {"QuestionDescriptionOption": "UseText", "CSSliderMin": -50, "CSSliderMax": 50, "GridLines": 10, "SnapToGrid": false, "NumDecimals": "0", "ShowValue": true, "CustomStart": false, "NotApplicable": false, "MobileFirst": true}, "Choices": {"1": {"Display": ""}}, "ChoiceOrder": ["1"], "Labels": {"1": {"Display": "-50<br>Strongly disagree"}, "2": {"Display": "+50<br>Strongly agree"}}, "Validation": {"Settings": {"ForceResponse": "ON", "ForceResponseType": "ON", "Type": "None"}}, "NextChoiceId": 2, "NextAnswerId": 1, "DataVisibility": {"Private": false, "Hidden": false}, "Language": [], "GradingData": [], "QuestionID": "QID13", "QuestionDescription": "Earlier, you wrote: \"${e://Field/topic}\" How much do you agree with this statement right now?"}}, {"SurveyID": "SV_evenHandedChat01", "Element": "SQ", "PrimaryAttribute": "QID14", "SecondaryAttribute": "After chatting with the AI, how certain are you that you know what your true attitude/belief on this", "TertiaryAttribute": null, "Payload": {"QuestionText": "After chatting with the AI, how certain are you that you know what your true attitude/belief on this topic really is?", "DataExportTag": "post_clarity", "QuestionType": "Slider", "Selector": "HSLIDER", "Configuration": {"QuestionDescriptionOption": "UseText", "CSSliderMin": 0, "CSSliderMax": 100, "GridL